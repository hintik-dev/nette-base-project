{**
 * @param Filter                $filter
 * @param Nette\Forms\Container $input
 * @param string                $iconPrefix       Icon prefix (fa fa-)
 *}

{var $container = $input}
{var $singleRange = (bool) $container['from']->getControlPrototype()->getAttribute('data-single-range')}
{var $fromId = $container['from']->getHtmlId()}
{var $toId = $container['to']->getHtmlId()}

{if $outer}
	<div class="row">
		{label $container['from'], class => 'col-sm-3 form-label' /}
		<div class="{$singleRange ? 'col-sm-9' : 'col-sm-4'} d-flex">
			{if $singleRange}
				<div class="d-flex flex-column gap-1 w-100">
					<div class="input-group input-group-sm">
						<span class="input-group-text">Od:</span>
						{input $container['from'], type => 'hidden', data-flatpickr-skip => 'true', data-provide => 'flatpickr', autocomplete => 'off'}
						<input
							type="text"
							id="{$fromId}-display"
							class="form-control form-control-sm flatpickr-input pe-3"
							data-model-input-id="{$fromId}"
							data-provide="flatpickr"
							data-readonly-picker="true"
							data-date-format="d.m.Y H:i"
							data-enable-time="true"
							data-time_24hr="true"
							data-minute-increment="1"
							data-default-hour="0"
							data-default-minute="0"
							autocomplete="off"
							readonly
						>
						<button type="button" class="flatpickr-clear-btn" data-flatpickr-clear="{$fromId}-display" tabindex="-1" title="Vymazat">
							<i class="bi bi-x"></i>
						</button>
					</div>
					<div class="input-group input-group-sm">
						<span class="input-group-text">Do:</span>
						{input $container['to'], type => 'hidden', data-flatpickr-skip => 'true', data-provide => 'flatpickr', autocomplete => 'off'}
						<input
							type="text"
							id="{$toId}-display"
							class="form-control form-control-sm flatpickr-input pe-3"
							data-model-input-id="{$toId}"
							data-provide="flatpickr"
							data-readonly-picker="true"
							data-date-format="d.m.Y H:i"
							data-enable-time="true"
							data-time_24hr="true"
							data-minute-increment="1"
							data-default-hour="23"
							data-default-minute="59"
							autocomplete="off"
							readonly
						>
						<button type="button" class="flatpickr-clear-btn" data-flatpickr-clear="{$toId}-display" tabindex="-1" title="Vymazat">
							<i class="bi bi-x"></i>
						</button>
					</div>
				</div>
			{else}
				<div class="input-group input-group-sm">
					{input $container['from'], data-provide => 'flatpickr'}
					<label n:name="$container['from']" class="input-group-text input-group-text-first">
						<i class="{$iconPrefix}calendar"></i>
					</label>
				</div>
			{/if}
		</div>
		{if $singleRange}
			{* single-range zobrazuje oba vstupy vpravo na dvou radcich *}
		{else}
			{label $container['to'], class => 'filter-range-delimiter col-sm-1 form-label' /}
			<div class="col-sm-4 d-flex">
				<div class="input-group input-group-sm">
					{input $container['to'], data-provide => 'flatpickr'}
					<label n:name="$container['to']" class="input-group-text">
						<i class="{$iconPrefix}calendar"></i>
					</label>
				</div>
			</div>
		{/if}
	</div>
{else}
	<div class="datagrid-col-filter-date-range d-flex">
		{if $singleRange}
			<div class="d-flex flex-column gap-1 w-100">
				<div class="input-group input-group-sm">
					<span class="input-group-text">Od:</span>
					{input $container['from'], type => 'hidden', data-flatpickr-skip => 'true', data-provide => 'flatpickr', autocomplete => 'off'}
					<input
						type="text"
						id="{$fromId}-display"
						class="form-control form-control-sm flatpickr-input pe-3"
						data-model-input-id="{$fromId}"
						data-provide="flatpickr"
						data-readonly-picker="true"
						data-date-format="d.m.Y H:i"
						data-enable-time="true"
						data-time_24hr="true"
						data-minute-increment="1"
						data-default-hour="0"
						data-default-minute="0"
						autocomplete="off"
						readonly
					>
					<button type="button" class="flatpickr-clear-btn" data-flatpickr-clear="{$fromId}-display" tabindex="-1" title="Vymazat">
						<i class="bi bi-x"></i>
					</button>
				</div>
				<div class="input-group input-group-sm">
					<span class="input-group-text">Do:</span>
					{input $container['to'], type => 'hidden', data-flatpickr-skip => 'true', data-provide => 'flatpickr', autocomplete => 'off'}
					<input
						type="text"
						id="{$toId}-display"
						class="form-control form-control-sm flatpickr-input pe-3"
						data-model-input-id="{$toId}"
						data-provide="flatpickr"
						data-readonly-picker="true"
						data-date-format="d.m.Y H:i"
						data-enable-time="true"
						data-time_24hr="true"
						data-minute-increment="1"
						data-default-hour="23"
						data-default-minute="59"
						autocomplete="off"
						readonly
					>
					<button type="button" class="flatpickr-clear-btn" data-flatpickr-clear="{$toId}-display" tabindex="-1" title="Vymazat">
						<i class="bi bi-x"></i>
					</button>
				</div>
			</div>
		{else}
			<div class="input-group input-group-sm">
				{input $container['from'], data-provide => 'flatpickr'}
				<label n:name="$container['from']" class="input-group-text input-group-text-first">
					<i class="{$iconPrefix}calendar"></i>
				</label>
			</div>

			<div class="datagrid-col-filter-range-delimiter">-</div>

			<div class="input-group input-group-sm">
				{input $container['to'], data-provide => 'flatpickr'}
				<label n:name="$container['to']" class="input-group-text">
					<i class="{$iconPrefix}calendar"></i>
				</label>
			</div>
		{/if}
	</div>
{/if}
