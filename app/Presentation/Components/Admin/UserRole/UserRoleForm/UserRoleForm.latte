{templateType App\Presentation\Components\Admin\UserRole\UserRoleForm\UserRoleFormTemplate}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">{if $editId !== null}Nastavení role{else}Nová role{/if}</h3>
    </div>
    <div class="card-body">
        {form form}
        {if $isDefaultRole}
            <div class="alert alert-secondary py-2 small">
                Výchozí role platí všem uživatelům včetně těch bez jakékoli role.
                Nelze ji přiřadit, smazat ani jí změnit prioritu.
            </div>
        {/if}

        <div class="mb-3">
            <label n:name="name" class="form-label">Název</label>
            {input name, class: 'form-control'}
            {inputError name}
        </div>

        <div class="mb-3">
            <label n:name="code" class="form-label">Kód</label>
            {input code, class: 'form-control font-monospace'}
            <div class="form-text">Strojový identifikátor. Po vytvoření se už nemění.</div>
            {inputError code}
        </div>

        <div class="mb-3">
            <label n:name="description" class="form-label">Popis</label>
            {input description, class: 'form-control', rows: 2}
            {inputError description}
        </div>

        <div class="mb-3">
            <label n:name="priority" class="form-label">Priorita</label>
            {input priority, class: 'form-control'}
            <div class="form-text">
                Vyšší priorita přepisuje nižší. Priority jsou unikátní, aby při skládání
                oprávnění nikdy nevznikly dvě role se stejnou vahou.
            </div>
            {inputError priority}
        </div>

        <div class="d-flex gap-2">
            {input submit, class: 'btn btn-primary'}
            <a href="{plink UserRole:}" class="btn btn-secondary">Zpět</a>
        </div>
        {/form}
    </div>
</div>
