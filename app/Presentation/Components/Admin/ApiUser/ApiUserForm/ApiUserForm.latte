<div class="card">
    <div class="card-header">
        <h3 class="card-title">{if $editId !== null}Upravit API uživatele{else}Nový API uživatel{/if}</h3>
    </div>
    <div class="card-body">
        {form form}
        <div class="mb-3">
            <label n:name="name" class="form-label">Název</label>
            {input name, class: 'form-control'}
            {inputError name}
        </div>
        <div class="mb-3">
            <label n:name="description" class="form-label">Popis</label>
            {input description, class: 'form-control', rows: 3}
            {inputError description}
        </div>
        <div class="mb-3">
            {input isActive}
            {label isActive /}
        </div>
        <div class="row mb-3">
            <div class="col">
                <label n:name="validFrom" class="form-label">Platný od</label>
                {input validFrom, class: 'form-control'}
                <div class="form-text">Nechat prázdné = bez omezení</div>
                {inputError validFrom}
            </div>
            <div class="col">
                <label n:name="validTo" class="form-label">Platný do</label>
                {input validTo, class: 'form-control'}
                <div class="form-text">Nechat prázdné = bez omezení</div>
                {inputError validTo}
            </div>
        </div>
        <div class="d-flex gap-2">
            {input submit, class: 'btn btn-primary'}
            <a href="{plink ApiUser:}" class="btn btn-secondary">Zpět</a>
        </div>
        {/form}
    </div>
</div>
