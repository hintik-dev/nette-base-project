<li n:snippet="bell" class="nav-item dropdown">
    <a class="nav-link d-flex align-items-center" href="#" data-bs-toggle="dropdown">
        <span class="position-relative d-inline-flex">
            <i class="bi bi-bell-fill fs-4"></i>
            <span n:if="$unreadCount > 0" class="notification-badge badge rounded-pill text-bg-danger">
                {$unreadCount}
                <span class="visually-hidden">nepřečtených notifikací</span>
            </span>
        </span>
    </a>
    <div class="dropdown-menu dropdown-menu-end p-0" style="width: 360px; max-height: 420px; overflow-y: auto;">
        <div class="d-flex justify-content-between align-items-center px-3 py-2">
            <strong>Notifikace</strong>
            <a n:if="$unreadCount > 0" n:href="markAllAsRead!" class="small ajax">Označit vše jako přečtené</a>
        </div>
        <div class="dropdown-divider m-0"></div>

        <div n:if="$recentNotifications === []" class="px-3 py-3 text-muted small text-center">
            Žádné notifikace
        </div>

        <div n:foreach="$recentNotifications as $notification"
             class="dropdown-item d-flex align-items-start gap-2 {if !$notification->isRead()}notification-unread{/if}">
            {if $notification->type === \App\Domain\Notification\NotificationType::Security}
                <i class="bi bi-shield-lock-fill text-danger mt-1"></i>
            {elseif $notification->type === \App\Domain\Notification\NotificationType::System}
                <i class="bi bi-megaphone-fill text-primary mt-1"></i>
            {elseif $notification->type === \App\Domain\Notification\NotificationType::Warning}
                <i class="bi bi-exclamation-triangle-fill text-warning mt-1"></i>
            {elseif $notification->type === \App\Domain\Notification\NotificationType::Success}
                <i class="bi bi-check-circle-fill text-success mt-1"></i>
            {else}
                <i class="bi bi-info-circle-fill text-secondary mt-1"></i>
            {/if}

            <a n:href="markAsRead!, id: $notification->recipientId" class="flex-grow-1 text-decoration-none text-body ajax">
                <div class="{if !$notification->isRead()}fw-bold{/if}">{$notification->title}</div>
                <div class="small text-muted fw-normal">{$notification->notificationCreatedAt->format('d.m.Y H:i')}</div>
            </a>

            <a n:href="hide!, id: $notification->recipientId" class="text-muted" title="Skrýt">
                <i class="bi bi-x-lg"></i>
            </a>
        </div>

        <div class="dropdown-divider m-0"></div>
        <a href="{plink :Admin:Notification:default}" class="dropdown-item text-center small">Zobrazit všechny</a>
    </div>
</li>
