{templateType App\Presentation\Components\Admin\User\UserForm\UserFormTemplate}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">{if $editId !== null}Upravit uživatele{else}Nový uživatel{/if}</h3>
    </div>
    <div class="card-body">
        {form form}
        <div class="mb-3">
            <label n:name="email" class="form-label">E-mail</label>
            {input email, class: 'form-control'}
            {inputError email}
        </div>
        <div class="mb-3">
            <label n:name="password" class="form-label">{label password /}</label>
            {input password, class: 'form-control'}
            <div n:if="$form['password']->getOption('description')" class="form-text">{$form['password']->getOption('description')}</div>
            {inputError password}
        </div>
        <div n:if="$isSuperadmin" class="alert alert-warning py-2 small">
            Tento účet je <strong>superadministrátor</strong> — obchází ACL a vidí vše
            bez ohledu na přiřazené role. Zrušit to lze jen z příkazové řádky.
        </div>
        <div n:if="$canAssignRoles" class="mb-3">
            <label n:name="roleIds" class="form-label">Role</label>
            {input roleIds, class: 'form-select', size: 6}
            <div class="form-text">
                Bez vybrané role platí uživateli jen výchozí role. Držte Ctrl pro výběr více rolí.
            </div>
            {inputError roleIds}
        </div>
        <div class="mb-3">
            {input active}
            {label active /}
        </div>
        <div class="d-flex gap-2">
            {input submit, class: 'btn btn-primary'}
            <a href="{$backLink}" class="btn btn-secondary">Zpět</a>
        </div>
        {/form}
    </div>
</div>
