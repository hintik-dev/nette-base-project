{templateType App\Presentation\Components\Admin\Page\PageForm\PageFormTemplate}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Nová stránka</h3>
    </div>
    <div class="card-body">
        {form form}
        <div class="mb-3">
            <label n:name="title" class="form-label">Název</label>
            {input title, class: 'form-control'}
            {inputError title}
        </div>
        <div class="mb-3">
            <label n:name="slug" class="form-label">Slug</label>
            {input slug, class: 'form-control'}
            <div class="form-text">Bez úvodního lomítka, např. <code>o-nas</code>. Ignoruje se u úvodní stránky.</div>
            {inputError slug}
        </div>
        <div class="mb-3">
            {input isHomepage}
            {label isHomepage /}
            <div class="form-text">Bude dostupná na kořenové adrese webu (<code>/</code>).</div>
            {inputError isHomepage}
        </div>
        <div class="d-flex gap-2">
            {input submit, class: 'btn btn-primary'}
            <a href="{$backLink}" class="btn btn-secondary">Zpět</a>
        </div>
        {/form}
    </div>
</div>
