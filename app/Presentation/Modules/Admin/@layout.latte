{varType Nette\Security\User $user}
{var $adminTheme = $presenter->getAdminTheme()}
{var $resolvedAdminTheme = $adminTheme === \App\Domain\UserSettings\AppearanceTheme::System ? 'light' : $adminTheme->value}
<!DOCTYPE html>
<html lang="cs" data-bs-theme="{$resolvedAdminTheme}">
<head>
    <script n:syntax="off">
    (function () {
        var resolved = document.documentElement.getAttribute('data-bs-theme');
        if (document.cookie.indexOf('admin_theme=system') !== -1 && window.matchMedia('(prefers-color-scheme:dark)').matches) {
            resolved = 'dark';
            document.documentElement.setAttribute('data-bs-theme', 'dark');
        }
        // AdminLTE má vlastní přepínač motivu s perzistencí do localStorage (klíč "lte-theme"),
        // který na DOMContentLoaded přebije data-bs-theme podle systémových preferencí, pokud
        // localStorage neobsahuje hodnotu – tím by přepsal námi vykreslený motiv. Udržujeme ho
        // proto v souladu s naším (cookie/DB) nastavením.
        try { localStorage.setItem('lte-theme', resolved); } catch (e) {}
    })();
    </script>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{ifset #title}{include #title|stripHtml} | {/ifset}Administrace</title>
    <link rel="icon" href="{$basePath}/favicon.ico">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/source-sans-3@5.0.12/index.css">
    {asset? 'admin/main.js'}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1/font/bootstrap-icons.min.css">
</head>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">

<div class="app-wrapper">

    {include navbar.latte}
    {control sidebarMenu}

    {* Main Content *}
    <main class="app-main">
        <div class="app-content-header">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-sm-6">
                        <h3 class="mb-0">{ifset #pageTitle}{include #pageTitle}{/ifset}</h3>
                    </div>
                    <div class="col-sm-6">
                        <ol class="breadcrumb float-sm-end">
                            <li class="breadcrumb-item"><a n:href="Home:default">Administrace</a></li>
                            <li class="breadcrumb-item active" aria-current="page">{ifset #pageTitle}{include #pageTitle}{/ifset}</li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>

        <div class="app-content">
            <div class="container-fluid">
                {include #content}
            </div>
        </div>
    </main>

    <footer class="app-footer">
        Administrace &copy; {date('Y')}
    </footer>

</div>

{include flashes.latte}

<div class="modal fade" id="datagridConfirmModal" tabindex="-1" aria-labelledby="datagridConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="datagridConfirmModalLabel">Potvrzení akce</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zavřít"></button>
            </div>
            <div class="modal-body">
                <p id="datagridConfirmMessage" class="mb-0"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Zrušit</button>
                <button type="button" class="btn btn-danger" id="datagridConfirmOk">Potvrdit</button>
            </div>
        </div>
    </div>
</div>
</body>
</html>
