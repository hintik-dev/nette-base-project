<aside class="app-sidebar sidebar-light-primary" data-bs-theme="light">

    <div class="sidebar-brand">
        <a n:href="Home:default" class="brand-link">
            <img src="{$basePath}/favicon.ico" alt="logo" width="33" height="33" class="brand-image">
            <span class="brand-text"><strong>Nette</strong> Admin</span>
        </a>
    </div>

    <div class="sidebar-wrapper">
        <nav class="mt-2">
            <ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" role="menu">

                <li class="nav-item">
                    <a n:href="Home:default" class="nav-link {if isLinkCurrent(':Admin:Home:default')}active{/if}">
                        <i class="nav-icon bi bi-house-fill"></i>
                        <p>Dashboard</p>
                    </a>
                </li>

                <li class="nav-item">
                    <a n:href="User:list" class="nav-link {if isLinkCurrent(':Admin:User:*')}active{/if}">
                        <i class="nav-icon bi bi-people-fill"></i>
                        <p>Uživatelé</p>
                    </a>
                </li>

                {var $scheduledJobActive = isLinkCurrent(':Admin:ScheduledJob:*')}
                <li class="nav-item {if $scheduledJobActive}menu-open{/if}">
                    <a href="#" class="nav-link {if $scheduledJobActive}active{/if}">
                        <i class="nav-icon bi bi-clock-fill"></i>
                        <p>
                            Plánované úlohy
                            <i class="nav-arrow bi bi-chevron-right"></i>
                        </p>
                    </a>
                    <ul class="nav nav-treeview">
                        <li class="nav-item">
                            <a n:href="ScheduledJob:default" class="nav-link ps-4 {if isLinkCurrent(':Admin:ScheduledJob:default')}active{/if}">
                                <i class="nav-icon bi bi-list-task"></i>
                                <p>Definice úloh</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a n:href="ScheduledJob:runs" class="nav-link ps-4 {if isLinkCurrent(':Admin:ScheduledJob:runs')}active{/if}">
                                <i class="nav-icon bi bi-journal-text"></i>
                                <p>Historie běhů</p>
                            </a>
                        </li>
                    </ul>
                </li>

                <li class="nav-header">Správa</li>

                <li class="nav-item">
                    <a n:href="ApiUser:default" class="nav-link {if isLinkCurrent(':Admin:ApiUser:*')}active{/if}">
                        <i class="nav-icon bi bi-key-fill"></i>
                        <p>API uživatelé</p>
                    </a>
                </li>

                {var $emailActive = isLinkCurrent(':Admin:Email:*')}
                <li class="nav-item {if $emailActive}menu-open{/if}">
                    <a href="#" class="nav-link {if $emailActive}active{/if}">
                        <i class="nav-icon bi bi-envelope-fill"></i>
                        <p>
                            E-maily
                            <i class="nav-arrow bi bi-chevron-right"></i>
                        </p>
                    </a>
                    <ul class="nav nav-treeview">
                        <li class="nav-item">
                            <a n:href="Email:list" class="nav-link ps-4 {if isLinkCurrent(':Admin:Email:list')}active{/if}">
                                <i class="nav-icon bi bi-send-fill"></i>
                                <p>Odeslané e-maily</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a n:href="Email:compose" class="nav-link ps-4 {if isLinkCurrent(':Admin:Email:compose')}active{/if}">
                                <i class="nav-icon bi bi-pencil-square"></i>
                                <p>Nový e-mail</p>
                            </a>
                        </li>
                    </ul>
                </li>

                <li class="nav-item">
                    <a n:href="UserSession:default" class="nav-link {if isLinkCurrent(':Admin:UserSession:default')}active{/if}">
                        <i class="nav-icon bi bi-person-badge-fill"></i>
                        <p>Session uživatelů</p>
                    </a>
                </li>

                <li class="nav-item">
                    <a n:href="AppSettings:general" class="nav-link {if isLinkCurrent(':Admin:AppSettings:*')}active{/if}">
                        <i class="nav-icon bi bi-gear-fill"></i>
                        <p>Nastavení</p>
                    </a>
                </li>

            </ul>
        </nav>
    </div>

</aside>
