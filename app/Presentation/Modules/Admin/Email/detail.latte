{templateType App\Presentation\Modules\Admin\Email\EmailDetailTemplate}

{block #pageTitle}Detail e-mailu #{$email->id}{/block}

{block #content}

<div class="card mb-3">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h3 class="card-title mb-0">Detail e-mailu #{$email->id}</h3>
        <a n:href="list" class="btn btn-sm btn-secondary">
            <i class="bi bi-arrow-left"></i> Zpět na seznam
        </a>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Příjemce</dt>
            <dd class="col-sm-9">{$email->recipient}</dd>

            <dt class="col-sm-3">Předmět</dt>
            <dd class="col-sm-9">{$email->subject}</dd>

            <dt class="col-sm-3">Stav</dt>
            <dd class="col-sm-9">
                {if $email->status === \App\Domain\Email\SentEmailStatus::Sent}
                    <span class="badge bg-success">Odesláno</span>
                {elseif $email->status === \App\Domain\Email\SentEmailStatus::Failed}
                    <span class="badge bg-danger">Chyba</span>
                {else}
                    <span class="badge bg-secondary">Čeká</span>
                {/if}
            </dd>

            {if $email->error !== null}
            <dt class="col-sm-3">Chyba</dt>
            <dd class="col-sm-9 text-danger">{$email->error}</dd>
            {/if}

            <dt class="col-sm-3">Vytvořeno</dt>
            <dd class="col-sm-9">{$email->createdAt->format('d.m.Y H:i:s')}</dd>

            {if $email->sentAt !== null}
            <dt class="col-sm-3">Odesláno</dt>
            <dd class="col-sm-9">{$email->sentAt->format('d.m.Y H:i:s')}</dd>
            {/if}
        </dl>
    </div>
</div>

{if $email->bodyHtml !== null}
<div class="card">
    <div class="card-header">
        <h3 class="card-title mb-0">Obsah e-mailu</h3>
    </div>
    <div class="card-body p-0">
        <iframe srcdoc="{$email->bodyHtml}" style="width:100%;height:500px;border:0;" sandbox="allow-same-origin"></iframe>
    </div>
</div>
{/if}

{/block}
