{layout '@layoutSign.latte'}

{block #title}Nastavení nového hesla{/block}

{block #content}
<div class="login-box">
    <div class="login-logo">
        <a href="#"><b>Nette</b> Admin</a>
    </div>

    <div class="card">
        <div class="card-body login-card-body">
            <p class="login-box-msg">Zadejte nové heslo ke svému účtu</p>

            {control passwordResetForm}
        </div>
    </div>
</div>
{/block}
