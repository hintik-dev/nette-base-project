{layout '@layoutSign.latte'}

{block #title}Zapomenuté heslo{/block}

{block #content}
<div class="login-box">
    <div class="login-logo">
        <a href="#"><b>Nette</b> Admin</a>
    </div>

    <div class="card">
        <div class="card-body login-card-body">
            <p class="login-box-msg">Zadejte e-mail a pošleme vám odkaz pro obnovu hesla</p>

            {control passwordResetRequestForm}

            <p class="mt-3 mb-0">
                <a href="{plink :Admin:Sign:in}">Zpět na přihlášení</a>
            </p>
        </div>
    </div>
</div>
{/block}
