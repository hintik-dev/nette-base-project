{block #pageTitle}Detail běhu #{$run->id}{/block}

{block #content}

<div class="card mb-4">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h3 class="card-title mb-0">Informace o běhu</h3>
        <a n:href="runs" class="btn btn-sm btn-secondary">
            <i class="bi bi-arrow-left"></i> Zpět na historii
        </a>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Úloha</dt>
            <dd class="col-sm-9">{$job->name} <code class="ms-2 text-muted">{$job->getShortClass()}</code></dd>

            <dt class="col-sm-3">Stav</dt>
            <dd class="col-sm-9">
                <span class="{$run->status->toBadgeClass()}">{$run->status->toLabel()}</span>
            </dd>

            <dt class="col-sm-3">Spuštění</dt>
            <dd class="col-sm-9">{$run->trigger->toLabel()}</dd>

            <dt class="col-sm-3">Zahájeno</dt>
            <dd class="col-sm-9">{$run->startedAt|date:'d.m.Y H:i:s'}</dd>

            <dt class="col-sm-3">Dokončeno</dt>
            <dd class="col-sm-9">{$run->finishedAt ? ($run->finishedAt|date:'d.m.Y H:i:s') : '—'}</dd>

            <dt class="col-sm-3">Trvání</dt>
            <dd class="col-sm-9">
                {if $run->durationMs !== null}
                    {if $run->durationMs >= 1000}{round($run->durationMs / 1000, 2)} s{else}{$run->durationMs} ms{/if}
                {else}—{/if}
            </dd>

            {if $run->error !== null}
            <dt class="col-sm-3 text-danger">Chyba</dt>
            <dd class="col-sm-9"><code class="text-danger">{$run->error}</code></dd>
            {/if}
        </dl>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title mb-0">Výpisy úlohy</h3>
    </div>
    <div class="card-body p-0">
        {control scheduledJobRunOutputGrid}
    </div>
</div>

{/block}
