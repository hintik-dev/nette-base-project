{* Zrcadlí assets/admin/editor/blocks/CTA.tsx — literální třídy v match()
   větvích, ne skládaný řetězec, viz komentář v .tsx protějšku. *}
{var $sectionClass = match($props['variant'] ?? 'primary') {
    'muted' => 'bg-base-200',
    default => 'bg-primary text-primary-content',
}}
{var $buttonClass = match($props['variant'] ?? 'primary') {
    'muted' => 'btn-primary',
    default => 'bg-base-100 text-primary border-none hover:bg-base-100/90',
}}
<div class="{$sectionClass}">
    <div class="container mx-auto px-4 py-16 text-center">
        <h2 class="text-3xl font-bold mb-4">{$props['heading'] ?? ''}</h2>
        <p n:if="!empty($props['subtext'])" class="opacity-80 mb-8 max-w-xl mx-auto">{$props['subtext']}</p>
        <a n:if="!empty($props['buttonText'])" href="{($props['buttonUrl'] ?? '')|safeUrl}" class="btn btn-lg shadow-lg {$buttonClass}">{$props['buttonText']}</a>
    </div>
</div>
