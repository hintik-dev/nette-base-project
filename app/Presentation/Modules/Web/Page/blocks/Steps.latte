{* Zrcadlí assets/admin/editor/blocks/Steps.tsx *}
<div class="bg-base-200 py-16">
    <div class="container mx-auto px-4">
        <div n:if="!empty($props['heading'])" class="max-w-2xl mx-auto text-center mb-10">
            <h2 class="text-3xl font-bold mb-4">{$props['heading']}</h2>
        </div>
        <ul class="steps steps-vertical lg:steps-horizontal w-full">
            <li n:foreach="$props['items'] ?? [] as $item" class="step step-primary">{$item['text'] ?? ''}</li>
        </ul>
    </div>
</div>
