{* Zrcadlí assets/admin/editor/blocks/Hero.tsx — literální třídy v match()
   větvích, ne skládaný řetězec, viz komentář v .tsx protějšku. *}
{var $variantClass = match($props['variant'] ?? 'neutral') {
    'primary' => 'bg-primary text-primary-content',
    'base-200' => 'bg-base-200',
    default => 'bg-neutral text-neutral-content',
}}
<div class="hero min-h-[60vh] {$variantClass}">
    <div class="hero-content text-center">
        <div class="max-w-md">
            <h1 class="text-5xl font-bold">{$props['heading'] ?? ''}</h1>
            <p n:if="!empty($props['subtext'])" class="py-6 opacity-80">{$props['subtext']}</p>
            <div class="flex gap-2 justify-center">
                <a n:if="!empty($props['primaryButtonText'])" href="{$props['primaryButtonUrl'] ?: '#'}" class="btn btn-primary">{$props['primaryButtonText']}</a>
                <a n:if="!empty($props['secondaryButtonText'])" href="{$props['secondaryButtonUrl'] ?: '#'}" class="btn btn-outline">{$props['secondaryButtonText']}</a>
            </div>
        </div>
    </div>
</div>
