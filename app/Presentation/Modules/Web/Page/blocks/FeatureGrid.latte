{* Zrcadlí assets/admin/editor/blocks/FeatureGrid.tsx — literální třídy
   v match() větvích, ne skládaný řetězec, viz komentář v .tsx protějšku. *}
{var $gridClass = match($props['columns'] ?? '4') {
    '2' => 'grid-cols-1 sm:grid-cols-2',
    '3' => 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3',
    default => 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-4',
}}
<div class="container mx-auto px-4 py-16">
    <div class="max-w-2xl mx-auto text-center mb-12">
        <h2 class="text-3xl font-bold mb-4">{$props['heading'] ?? ''}</h2>
        <p n:if="!empty($props['intro'])" class="text-base-content/70">{$props['intro']}</p>
    </div>
    <div class="grid {$gridClass} gap-6">
        <div n:foreach="$props['items'] ?? [] as $item" class="card bg-base-100 shadow-sm">
            <div class="card-body items-center text-center">
                <h3 class="card-title text-base">{$item['title'] ?? ''}</h3>
                <p class="text-sm text-base-content/70">{$item['text'] ?? ''}</p>
            </div>
        </div>
    </div>
</div>
