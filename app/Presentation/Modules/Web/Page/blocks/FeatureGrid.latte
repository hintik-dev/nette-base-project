{* Zrcadlí assets/admin/editor/blocks/FeatureGrid.tsx — literální třídy
   v match() větvích, ne skládaný řetězec, viz komentář v .tsx protějšku. *}
{var $gridClass = match($props['columns'] ?? '4') {
    '2' => 'grid-cols-1 sm:grid-cols-2',
    '3' => 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3',
    default => 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-4',
}}
{* Ikony se střídají po třech barvách palety, viz komentář v .tsx protějšku. *}
{var $iconBadgeClasses = ['bg-primary/10 text-primary', 'bg-secondary/10 text-secondary', 'bg-accent/10 text-accent']}
<div class="container mx-auto px-4 py-16">
    <div class="max-w-2xl mx-auto text-center mb-12">
        <span class="inline-block font-mono text-xs uppercase tracking-widest text-base-content/50 border border-base-300 rounded-full px-3 py-1 mb-4">Vlastnosti</span>
        <h2 class="text-3xl font-bold mb-4">{$props['heading'] ?? ''}</h2>
        <p n:if="!empty($props['intro'])" class="text-base-content/70">{$props['intro']}</p>
    </div>
    <div class="grid {$gridClass} gap-4">
        <div n:foreach="$props['items'] ?? [] as $item" class="rounded-2xl border border-base-300/60 bg-base-100/70 backdrop-blur shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all p-6 {$iterator->first ? 'sm:col-span-2' : ''}">
            <div n:if="!empty($item['icon'])" class="w-12 h-12 rounded-xl flex items-center justify-center text-xl mb-3 {$iconBadgeClasses[$iterator->counter0 % 3]}">{$item['icon']}</div>
            <h3 class="font-semibold text-base mb-1">{$item['title'] ?? ''}</h3>
            <p class="text-sm text-base-content/70">{$item['text'] ?? ''}</p>
        </div>
    </div>
</div>
