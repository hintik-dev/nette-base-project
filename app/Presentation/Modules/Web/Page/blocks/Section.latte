{* Zrcadlí assets/admin/editor/blocks/Section.tsx — slot "content" je vnořené
   pole bloků (stejný formát jako $blocks v BlockRenderer::render()), proto
   se vykresluje rekurzivně přes $blockRenderer, viz Columns.latte. *}
{var $backgroundClass = match($props['background'] ?? 'none') {
    'muted' => 'bg-base-200/60',
    default => '',
}}
<div class="{$backgroundClass}">
    <div class="container mx-auto px-4 py-14">
        <div class="max-w-2xl mx-auto text-center mb-10">
            <span n:if="!empty($props['eyebrow'])" class="inline-block font-mono text-xs uppercase tracking-widest text-base-content/50 border border-base-300 rounded-full px-3 py-1 mb-4">{$props['eyebrow']}</span>
            <h2 class="text-3xl font-bold mb-4">{$props['heading'] ?? ''}</h2>
            <p n:if="!empty($props['subtext'])" class="text-base-content/70">{$props['subtext']}</p>
        </div>
        {$blockRenderer->render($props['content'] ?? [])|noescape}
    </div>
</div>
