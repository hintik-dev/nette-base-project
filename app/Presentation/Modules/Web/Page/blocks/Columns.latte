{* Zrcadlí assets/admin/editor/blocks/Columns.tsx — sloty "left"/"right" jsou
   vnořené pole bloků (stejný formát jako $blocks v BlockRenderer::render()),
   proto se vykreslují rekurzivně přes $blockRenderer. *}
<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem">
    <div>{$blockRenderer->render($props['left'] ?? [])|noescape}</div>
    <div>{$blockRenderer->render($props['right'] ?? [])|noescape}</div>
</div>
