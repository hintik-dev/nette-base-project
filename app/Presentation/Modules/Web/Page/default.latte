{templateType App\Presentation\Modules\Web\Page\PageDefaultTemplate}

{block #title}{$browserTitle}{/block}

{* Titulek stránky si redaktor skládá sám blokem Nadpis — generický
   #pageHeader banner z @layout.latte by ho zdvojoval. *}
{block #pageHeader}{/block}

{* Bez obalového containeru: sekční bloky (Hero, FeatureGrid, Steps) si
   nesou vlastní plnou šířku a padding, aby jejich pozadí sahalo od
   okraje k okraji obrazovky (ne jako vsazený box uprostřed stránky).
   Textové bloky (Heading, Text, seznamy, Sloupce, Obrázek) si container
   a typografii řeší samy, viz jejich vlastní .latte šablony. *}
{block #content}
    {$contentHtml|noescape}
{/block}
