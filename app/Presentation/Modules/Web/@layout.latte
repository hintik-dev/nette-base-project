{varType Nette\Security\User $user}

{layout '../Base/@layout.latte'}

{block #title}Web{/block}

{block #head}
    {asset? 'web/main.js'}
    <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,600,700" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1/font/bootstrap-icons.min.css">
{/block}

{block #body}
    {include #header}

    <main>
        {include #content}
    </main>

    {include #footer}
{/block}

{block #header}
    <header class="position-relative">
        <nav class="navbar navbar-expand-lg navbar-dark bg-gradient-dark shadow-none">
            <div class="container">
                <a class="navbar-brand text-white" n:href="Home:default">Váš web</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Přepnout navigaci">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item">
                            <a class="nav-link text-white" n:href="Home:default">Domů</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        {ifset #pageHeader}{include #pageHeader}{/ifset}
    </header>
{/block}

{block #pageHeader}
    <div class="page-header min-vh-25 bg-gradient-dark">
        <div class="container">
            <div class="row">
                <div class="col-lg-8 text-center mx-auto">
                    {ifset #pageTitle}<h1 class="text-white">{include #pageTitle}</h1>{/ifset}
                </div>
            </div>
        </div>
        <div class="position-absolute w-100 z-index-1 bottom-0">
            <svg class="waves" xmlns="https://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"
                 viewBox="0 24 150 40" preserveAspectRatio="none" shape-rendering="auto">
                <defs>
                    <path id="gentle-wave" d="M-160 44c30 0 58-5 88-5s 58 5 88 5 58-5 88-5 58 5 88 5 v20h-352z" />
                </defs>
                <g class="moving-waves">
                    <use xlink:href="#gentle-wave" x="48" y="12" fill="rgba(251,251,251,0.40)" />
                    <use xlink:href="#gentle-wave" x="48" y="16" fill="rgba(251,251,251,0.95)" />
                </g>
            </svg>
        </div>
    </div>
{/block}

{block #footer}
    <footer class="footer py-5">
        <hr class="horizontal dark">
        <div class="container">
            <div class="row">
                <div class="col-12 text-center">
                    <p class="mb-0 text-sm text-muted">&copy; {date('Y')} Váš web</p>
                </div>
            </div>
        </div>
    </footer>
{/block}
