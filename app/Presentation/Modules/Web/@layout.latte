{varType Nette\Security\User $user}

{layout '../Base/@layout.latte'}

{block #title}Web{/block}

{block #head}{asset? 'web/main.js'}{/block}

{block #body}
    <div class="drawer">
        <input id="nav-drawer" type="checkbox" class="drawer-toggle">
        <div class="drawer-content flex flex-col min-h-screen">
            {include #header}
            <main class="flex-1">
                {include #content}
            </main>
            {include #footer}
        </div>
        <div class="drawer-side z-50">
            <label for="nav-drawer" aria-label="Zavřít menu" class="drawer-overlay"></label>
            <ul class="menu bg-base-200 min-h-full w-64 p-4">
                <li><a n:href="Home:default">Domů</a></li>
                <li><a n:href="Page:default, slug: 'o-nas'">O nás</a></li>
            </ul>
        </div>
    </div>
{/block}

{block #header}
    <div class="navbar bg-neutral text-neutral-content">
        <div class="flex-none lg:hidden">
            <label for="nav-drawer" class="btn btn-square btn-ghost" aria-label="Otevřít menu">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </label>
        </div>
        <div class="flex-1">
            <a class="btn btn-ghost text-xl" n:href="Home:default">Váš web</a>
        </div>
        <div class="flex-none hidden lg:block">
            <ul class="menu menu-horizontal px-1">
                <li><a n:href="Home:default">Domů</a></li>
                <li><a n:href="Page:default, slug: 'o-nas'">O nás</a></li>
            </ul>
        </div>
    </div>

    {ifset #pageHeader}{include #pageHeader}{/ifset}
{/block}

{block #pageHeader}
    <div class="hero bg-base-200 py-16">
        <div class="hero-content text-center">
            <div class="max-w-md">
                {ifset #pageTitle}<h1 class="text-4xl font-bold">{include #pageTitle}</h1>{/ifset}
            </div>
        </div>
    </div>
{/block}

{block #footer}
    <footer class="footer sm:footer-horizontal bg-base-200 text-base-content px-4 sm:px-10 pt-10 pb-6">
        <nav>
            <h6 class="footer-title">Web</h6>
            <a class="link link-hover" n:href="Home:default">Domů</a>
            <a class="link link-hover" n:href="Page:default, slug: 'o-nas'">O nás</a>
        </nav>
        <nav>
            <h6 class="footer-title">O projektu</h6>
            <span class="opacity-70">Postaveno na Nette Frameworku</span>
            <span class="opacity-70">Obsah spravovaný vizuálním editorem</span>
        </nav>
    </footer>
    <footer class="footer footer-center bg-base-200 text-base-content border-t border-base-300 px-4 py-4">
        <aside>
            <p>&copy; {date('Y')} Váš web</p>
        </aside>
    </footer>
{/block}
