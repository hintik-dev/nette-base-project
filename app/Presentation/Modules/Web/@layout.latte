{varType Nette\Security\User $user}

{layout '../Base/@layout.latte'}

{block #title}Web{/block}

{block #head}
    {asset? 'web/main.js'}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
{/block}

{block #body}
    <div class="drawer">
        <input id="nav-drawer" type="checkbox" class="drawer-toggle">
        <div class="drawer-content flex flex-col min-h-screen">
            {include #header}
            <main class="flex-1">
                {include #content}
            </main>
            {include #footer}
        </div>
        <div class="drawer-side z-50">
            <label for="nav-drawer" aria-label="Zavřít menu" class="drawer-overlay"></label>
            <ul class="menu bg-base-200 min-h-full w-64 p-4">
                <li><a n:href="Page:default, slug: ''">Domů</a></li>
                <li><a n:href="Page:default, slug: 'o-nas'">O nás</a></li>
            </ul>
        </div>
    </div>
{/block}

{block #header}
    <div class="navbar bg-base-100/90 backdrop-blur border-b border-base-300 sticky top-0 z-40">
        <div class="flex-none lg:hidden">
            <label for="nav-drawer" class="btn btn-square btn-ghost" aria-label="Otevřít menu">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </label>
        </div>
        <div class="flex-1">
            <a class="btn btn-ghost font-display text-xl font-bold tracking-tight" n:href="Page:default, slug: ''">Váš web</a>
        </div>
        <div class="flex-none hidden lg:block">
            <ul class="menu menu-horizontal px-1">
                <li><a n:href="Page:default, slug: ''">Domů</a></li>
                <li><a n:href="Page:default, slug: 'o-nas'">O nás</a></li>
            </ul>
        </div>
    </div>
{/block}

{block #footer}
    {* daisyUI footer sám o sobě sloupce velikostně přizpůsobuje obsahu
       (grid-auto-columns), ne rovnoměrně na celou šířku — se 3 krátkými
       sloupci pak vpravo zbyde prázdné místo. sm:grid-cols-3 to přebije
       na rovnoměrné rozdělení. Zároveň (na rozdíl od Hero/FeatureGrid/Steps)
       patičce chyběl container mx-auto — na širších obrazovkách se proto
       roztahovala přes celé okno, zatímco obsah nad ní byl centrovaný
       v užším kontejneru, což vypadalo, jako by byla patička posunutá
       vlevo. Pozadí zůstává full-bleed (na vnějším divu), obsah je
       zarovnaný do stejného container mx-auto jako zbytek stránky. *}
    <div class="bg-base-200 text-base-content border-t border-base-300">
        <footer class="footer sm:footer-horizontal sm:grid-cols-3 container mx-auto px-4 sm:px-10 pt-12 pb-8">
            <aside>
                <p class="font-display text-lg font-bold tracking-tight">Váš web</p>
                <p class="font-mono text-xs uppercase tracking-widest opacity-50">poskládáno z bloků</p>
            </aside>
            <nav>
                <h6 class="footer-title opacity-50">Web</h6>
                <a class="link link-hover" n:href="Page:default, slug: ''">Domů</a>
                <a class="link link-hover" n:href="Page:default, slug: 'o-nas'">O nás</a>
            </nav>
            <nav>
                <h6 class="footer-title opacity-50">O projektu</h6>
                <span class="opacity-60">Postaveno na Nette Frameworku</span>
                <span class="opacity-60">Obsah spravovaný vizuálním editorem</span>
            </nav>
        </footer>
    </div>
    <div class="bg-base-200 text-base-content border-t border-base-300">
        <footer class="footer footer-center container mx-auto px-4 py-4">
            <aside>
                <p class="opacity-50 text-sm">&copy; {date('Y')} Váš web</p>
            </aside>
        </footer>
    </div>
{/block}
